# MotorLedger environment variable names only. Never commit real credentials.
# Copy to .env and fill in values locally or via a secret manager.

# Application
APP_NAME=MotorLedger
APP_ENV=development
# development | demonstration | test | production
APP_BASE_URL=http://localhost:3000
APP_DEMO_MODE=false

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/motorledger

# Session / CSRF
SESSION_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-long-random-string

# Email (interface — leave blank to use the console adapter)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Private document storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Market data providers (leave blank if unconfigured)
OLD_CARS_DATA_API_BASE_URL=
OLD_CARS_DATA_API_KEY=
BLACK_BOOK_API_BASE_URL=
BLACK_BOOK_API_KEY=
JD_POWER_API_BASE_URL=
JD_POWER_API_KEY=

# Vehicle history / title / theft / odometer (leave blank if unconfigured)
VEHICLE_HISTORY_PROVIDER=
VEHICLE_HISTORY_API_BASE_URL=
VEHICLE_HISTORY_API_KEY=
TITLE_PROVIDER=
TITLE_API_BASE_URL=
TITLE_API_KEY=
THEFT_PROVIDER=
THEFT_API_BASE_URL=
THEFT_API_KEY=
NMVTIS_PROVIDER=
NMVTIS_API_BASE_URL=
NMVTIS_API_KEY=

# FX rates for currency normalization
FX_PROVIDER=
FX_API_BASE_URL=
FX_API_KEY=

# Malware scanning (interface — leave blank if unconfigured)
MALWARE_SCAN_PROVIDER=
MALWARE_SCAN_API_BASE_URL=
MALWARE_SCAN_API_KEY=

# Background jobs
JOB_PROVIDER=inline
REDIS_URL=

# Rate limiting
RATE_LIMIT_PROVIDER=memory
AUTH_RATE_LIMIT_PER_MINUTE=10
SHARE_RATE_LIMIT_PER_MINUTE=20

# File uploads
MAX_UPLOAD_BYTES=26214400

# Report verification
REPORT_VERIFICATION_PATH=/verify
